+// CefBrowserHost::WasHidden for one off-screen browser: a hidden browser stops rendering, painting and running animation frames, like a
+// background tab in Chrome. (The JCEF Java class only forwards visibility for windowed browsers.) Returns false if it is not created yet.
+JNIEXPORT jboolean JNICALL
+Java_com_levviata_integratedntwiki_mcef_NativeExt_setHidden0(
+    JNIEnv* env,
+    jclass,
+    jobject jbrowser,
+    jboolean hidden) {
+  CefRefPtr<CefBrowser> browser = GetJNIBrowser(env, jbrowser);
+  if (!browser.get() || !browser->GetHost())
+    return JNI_FALSE;
+  browser->GetHost()->WasHidden(hidden == JNI_TRUE);
+  return JNI_TRUE;
+}
+
 }  // extern "C"
