+// A thread that was not started by Java (Chromium's own threads, in MCEF's threaded message loop mode) is attached to the JVM the first time
+// it calls into Java and stays attached until the thread exits. Attaching and detaching around every callback made the JVM create a new
+// java.lang.Thread for each one (about 400 a second while a page was painting).
+struct ThreadAttachment {
+  bool attached = false;
+  ~ThreadAttachment();
+};
+thread_local ThreadAttachment tlsAttachment;
